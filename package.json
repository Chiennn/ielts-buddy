{
  "name": "ielts-buddy",
  "version": "0.0.1",
  "description": "IELTS Buddy - Interactive learning platform",
  "private": true,
  "scripts": {
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:backend": "cd apps/backend && npm start",
    "build:frontend": "cd apps/frontend && npm run build",
